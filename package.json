{
  "name": "dsh-minimax-quota",
  "version": "1.0.0",
  "description": "Shows the remaining MiniMax coding-plan quota (5-hour window and weekly window) below the DeepSeek Harness chat composer, with the detail on click.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "minimax",
    "quota",
    "usage",
    "web-ui"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.en.md",
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "dsh-plugin.json",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "package-lock.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woaiCarlos/dsh-minimax-quota.git"
  },
  "homepage": "https://github.com/woaiCarlos/dsh-minimax-quota#readme",
  "bugs": {
    "url": "https://github.com/woaiCarlos/dsh-minimax-quota/issues"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --check index.js && node --check client.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
